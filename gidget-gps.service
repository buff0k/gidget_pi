{% extends "base.html" %}

{% set active_page = "files" %}

{% block content %}
<section class="page-wrap">
    <div class="card">
        <h2>Files</h2>

        <p class="muted">
            Read-only browser for <code>/opt/gidget</code>. Files can be viewed or downloaded, but not edited here.
        </p>

        <div class="file-toolbar">
            <button id="rootBtn">Root</button>
            <button id="upBtn">Up</button>
            <button id="refreshBtn">Refresh</button>
            <span id="currentPath" class="value"></span>
        </div>

        <div id="filesMessage" class="status-box"></div>

        <div class="files-layout">
            <div class="card file-list-card">
                <h2>Browser</h2>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Size</th>
                                <th>Modified</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="fileListBody">
                            <tr>
                                <td colspan="5">Loading...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card file-view-card">
                <h2 id="viewerTitle">Viewer</h2>

                <div class="viewer-meta" id="viewerMeta">Select a text file to view.</div>

                <pre id="fileViewer" class="file-viewer"><code></code></pre>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script src="/static/files.js"></script>
{% endblock %}
