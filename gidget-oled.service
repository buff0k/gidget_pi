{% extends "base.html" %}

{% set active_page = "gps_telemetry" %}

{% block content %}
<section class="page-wrap">
    <div class="card">
        <h2>GPS Telemetry</h2>

        <div class="grid">
            <div class="metric"><div class="label">Fix</div><div id="fixStatus" class="value">n/a</div></div>
            <div class="metric"><div class="label">Constellations</div><div id="constellations" class="value">n/a</div></div>
            <div class="metric"><div class="label">Satellites Used</div><div id="satellitesUsedCount" class="value">n/a</div></div>
            <div class="metric"><div class="label">Satellites Visible</div><div id="satellitesVisibleCount" class="value">n/a</div></div>
            <div class="metric"><div class="label">PDOP</div><div id="pdop" class="value">n/a</div></div>
            <div class="metric"><div class="label">HDOP</div><div id="hdop" class="value">n/a</div></div>
            <div class="metric"><div class="label">VDOP</div><div id="vdop" class="value">n/a</div></div>
            <div class="metric"><div class="label">Last Update</div><div id="lastUpdate" class="value">n/a</div></div>
        </div>
    </div>

    <div class="card">
        <h2>Satellites Used in Fix</h2>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Satellite ID</th>
                        <th>Talker</th>
                        <th>Constellation</th>
                    </tr>
                </thead>
                <tbody id="usedSatellitesBody">
                    <tr><td colspan="3">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <h2>Visible Satellites</h2>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Satellite ID</th>
                        <th>Talker</th>
                        <th>Constellation</th>
                        <th>Elevation</th>
                        <th>Azimuth</th>
                        <th>SNR</th>
                        <th>Last Seen</th>
                    </tr>
                </thead>
                <tbody id="visibleSatellitesBody">
                    <tr><td colspan="7">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <h2>Raw GPS Serial Terminal</h2>
        <div id="gpsTerminal" class="terminal">Waiting for NMEA...</div>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script src="/static/gps_telemetry.js"></script>
{% endblock %}
